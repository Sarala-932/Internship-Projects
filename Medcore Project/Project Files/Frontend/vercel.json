{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://medcore-hms.duckdns.org/api/:match*"
    },
    {
      "source": "/socket.io/:match*",
      "destination": "https://medcore-hms.duckdns.org/socket.io/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
